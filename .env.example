# Required Gemini configuration
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# Required Filesystem MCP configuration. Arguments must be a JSON array.
MCP_FILESYSTEM_COMMAND=npx
MCP_FILESYSTEM_ARGS_JSON=["-y","@modelcontextprotocol/server-filesystem","./sandbox"]
MCP_ALLOWED_ROOTS=./sandbox

# Execution limits
MCP_TIMEOUT=30s
LLM_TIMEOUT=45s
AGENT_MAX_ITERATIONS=8
MCP_MAX_RESULT_BYTES=65536

# Optional
HOST_LOG_LEVEL=info
